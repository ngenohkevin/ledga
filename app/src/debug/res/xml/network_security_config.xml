<?xml version="1.0" encoding="utf-8"?>
<!-- Ledga dev only (owner call A, R140): the S26 update test's local server is plain HTTP on 127.0.0.1, through adb reverse.
     Every other address keeps Android's default (no cleartext). The release build has no network config at all. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
