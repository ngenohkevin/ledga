<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- R113, Ledga dev only: adb posts a sample of each alert for the S26 check. DUMP keeps it to adb. -->
        <receiver
            android:name="com.ledga.app.debug.DebugAlertReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.ledga.app.DEBUG_ALERT" />
            </intent-filter>
        </receiver>
        <!-- Owner call A, Ledga dev only: adb points the update check at the S26 test server. DUMP keeps it to adb. -->
        <receiver
            android:name="com.ledga.app.debug.DebugUpdateReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.ledga.app.DEBUG_UPDATES" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
