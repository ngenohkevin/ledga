<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- R113, Ledga dev only: adb posts a sample of each alert for the S26 check. DUMP keeps it to adb. -->
        <receiver
            android:name="com.ledga.app.debug.DebugAlertReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.ledga.app.DEBUG_ALERT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
